# Supabase REST configuration (use either the standard names or existing project names)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_SECRET_KEY is also supported for the dashboard's Secret key.
# Supported legacy names: API_URL, APIKey, ProjectURL, and SecretKey.
# A URL ending in /rest/v1 is normalized.
# Publishable/anon keys are not valid server sync credentials.